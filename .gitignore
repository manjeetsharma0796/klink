# Ignore everything by default
*

# Allow the directories we care about
!.gitignore
!.gitattributes
!AGENTS.md
!CLAUDE.md
!CONTEXT.md
!DOCS_INDEX.md
!README.md
!TODO.md
!docs/
!docs/**
!.github/
!.github/**

# Code dirs
!apps/
!apps/**
!programs/
!programs/**
!scripts/
!scripts/**

# Root config files (committed)
!package.json
!bunfig.toml
!bun.lock
!biome.json

# Future config files (uncomment when added by scaffold tasks)
# !tsconfig.json
# !Anchor.toml
# !Cargo.toml

# Always-ignore patterns (defense in depth)
node_modules/
.env
.env.*
!**/.env.example
*.log
.DS_Store
target/
dist/
build/
.anchor/
test-ledger/
*.tsbuildinfo
.next/
