# Ignore everything by default
*

# Allow the directories we care about
!.gitignore
!AGENTS.md
!CLAUDE.md
!CONTEXT.md
!DOCS_INDEX.md
!README.md
!TODO.md
!docs/
!docs/**
!.github/
!.github/**

# Code dirs
!apps/
!apps/**
!programs/
!programs/**

# Future config files (uncomment when added by scaffold tasks)
# !package.json
# !pnpm-workspace.yaml
# !pnpm-lock.yaml
# !tsconfig.json
# !Anchor.toml
# !Cargo.toml

# Always-ignore patterns (defense in depth)
node_modules/
.env
.env.*
*.log
.DS_Store
target/
dist/
build/
.anchor/
test-ledger/
