# Copy to .env and fill in. .env is gitignored.

# HTTP server
PORT=3000

# Postgres connection — provisioned in T-402 (shared dev DB)
DATABASE_URL=postgres://klink:klink@localhost:5432/klink_dev

# Master key for AES-256-GCM session-secret encryption (T-208)
# Generate with: openssl rand -hex 32
SESSION_SECRET_MASTER_KEY=

# JWT signing secret for SIWS auth (T-203)
# Generate with: openssl rand -hex 32
JWT_SECRET=
