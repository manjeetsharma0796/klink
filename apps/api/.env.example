# Copy to .env and fill in. .env is gitignored.

# HTTP server
PORT=3000

# Postgres connection — provisioned in T-402 (shared dev DB)
DATABASE_URL=postgres://klink:klink@localhost:5432/klink_dev

# Redis (Upstash TLS) — used by SIWS nonce store
REDIS_URL=

# Master key for AES-256-GCM session-secret encryption (T-208)
# Generate with: openssl rand -hex 32
SESSION_SECRET_MASTER_KEY=

# JWT signing secret for SIWS auth (T-203)
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Solana RPC — Helius devnet (T-401)
SOLANA_RPC_URL=

# Devnet USDC mint
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU

# On-chain program ID (defaults to Anchor.toml-pinned ID if omitted)
# KLINK_PROGRAM_ID=

# Dodo Payments fiat-in (T-214 / T-215)
DODO_API_BASE_URL=
DODO_API_KEY=
DODO_WEBHOOK_SECRET=

# Treasury wallet for Dodo disbursements (T-215)
# Base58 secret key or solana-keygen JSON array
TREASURY_SECRET_KEY=
TREASURY_USDC_ATA=

# Kamino reserve addresses — populated after T-113 devnet deploy
KAMINO_RESERVE=
KAMINO_LENDING_MARKET=
KAMINO_LENDING_MARKET_AUTHORITY=
KAMINO_RESERVE_LIQUIDITY_SUPPLY=
KAMINO_RESERVE_COLLATERAL_MINT=
