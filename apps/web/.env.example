# Copy to .env.local and fill in. .env* is gitignored except .env.example.

# Solana RPC URL — devnet by default. Real RPC chosen in T-401.
# NEXT_PUBLIC_* vars are bundled into the client; never put secrets here.
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com

# Backend API base URL — used by T-302+ data calls.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000

# Server-only override for the backend URL. Falls back to NEXT_PUBLIC_API_BASE_URL.
# Use this when the dashboard speaks to the API on a private network in prod.
# KLINK_API_URL=http://api.internal:3000

# JWT signing secret — MUST match apps/api .env JWT_SECRET. Used to verify the
# klink_session cookie issued after SIWS sign-in. Generate with `openssl rand -hex 32`.
JWT_SECRET=

# Force the Secure flag on the session cookie. Defaults to NODE_ENV=production.
# KLINK_COOKIE_SECURE=true
